<UserControl x:Class="SearchPopup.SearchPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SearchPopup"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/SearchPopup;component/Dictionary1.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Popup x:Name="popupControl" StaysOpen="True" LostFocus="popupControl_LostFocus">
            <ListView ItemsSource="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Column="0" BorderThickness="0" Text="{Binding ElementText}" />

                            <Image Grid.Column="1" Source="/SearchPopup;component/resources/notStarred.png" Visibility="{Binding IsFavorite, Converter={StaticResource BoolInverseVisibility}}" MouseDown="Image_MouseDown"/>
                            <Image Grid.Column="1" Source="/SearchPopup;component/resources/starred.png" Visibility="{Binding IsFavorite, Converter={StaticResource BoolVisibility}}" MouseDown="Image_MouseDown"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Popup>
    </Grid>
</UserControl>
